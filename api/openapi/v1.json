            "title": "Id",
            "type": "string"
          },
          "metric": {
            "title": "Metric",
            "type": "string"
          },
          "period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
