    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "Vercel rewrites /api and /v1 to Railway",
        "Rate limit, auth, RBAC and credit reserve before any engine",
        "Answers stream back as SSE"
      ]
    },
    {
      "dot": "emerald",
      "title": "AI",
      "items": [
        "gpt-oss-20b on Groq by default, Bedrock optional",
        "Gemini 2.5 Flash fallback and LangExtract",
        "Local ONNX embeddings and reranker"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "sqlglot AST check and read-only transactions",
        "SSRF check with pinned DNS",
        "Generated code runs only in E2B"
